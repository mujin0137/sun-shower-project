# MongoDB 연결
MONGODB_URI=mongodb://localhost:27017/sun-shower
# 또는 MongoDB Atlas 사용시:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sun-shower

# 서버 포트
PORT=5000

# 날씨 API (OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweather_api_key_here
# 무료 API 키는 https://openweathermap.org/api 에서 발급

# Kakao Map API
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
# Kakao Developers에서 발급: https://developers.kakao.com

# Naver Map API (선택사항)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
# Naver Cloud Platform에서 발급: https://www.ncloud.com

# ODsay 대중교통 API
ODSAY_API_KEY=your_odsay_api_key_here
# ODsay Lab에서 발급: https://lab.odsay.com


 